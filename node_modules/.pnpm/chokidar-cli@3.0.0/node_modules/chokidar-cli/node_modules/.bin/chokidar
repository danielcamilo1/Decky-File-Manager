esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/var/home/Rafaelo/steam-os-file-manager/node_modules/.pnpm/chokidar-cli@3.0.0/node_modules/chokidar-cli/node_modules:/var/home/Rafaelo/steam-os-file-manager/node_modules/.pnpm/chokidar-cli@3.0.0/node_modules:/var/home/Rafaelo/steam-os-file-manager/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/var/home/Rafaelo/steam-os-file-manager/node_modules/.pnpm/chokidar-cli@3.0.0/node_modules/chokidar-cli/node_modules:/var/home/Rafaelo/steam-os-file-manager/node_modules/.pnpm/chokidar-cli@3.0.0/node_modules:/var/home/Rafaelo/steam-os-file-manager/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../index.js" "$@"
else
  exec node  "$basedir/../../index.js" "$@"
fi
